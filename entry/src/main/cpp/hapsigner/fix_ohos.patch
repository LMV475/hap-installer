+#ifndef SIGNATRUETOOLS_SIGN_THREAD_POOL_H
+#define SIGNATRUETOOLS_SIGN_THREAD_POOL_H
+
+#include <memory>
+#include "thread_pool.h"
+
+namespace OHOS {
+namespace SignatureTools {
+// 端侧签名进程级共享线程池：
+// - 池大小 = 1：规避设备沙箱内多线程触发的 signo(42)（详见鸿蒙迁移方案.md §廿一）
+// - 全进程唯一：避免每个 MerkleTreeBuilder / CodeSigning 实例各自 new ThreadPool 造成线程反复起停
+// 前提：HandleZipGlobalInfo 已改串行（方案 A），任务内部不再向本池 Enqueue，因此 1 线程池不会自锁。
+inline std::shared_ptr<Uscript::ThreadPool> GetSharedSignPool()
+{
+    static const std::shared_ptr<Uscript::ThreadPool> pool =
+        std::make_shared<Uscript::ThreadPool>(1);
+    return pool;
+}
+} // namespace SignatureTools
+} // namespace OHOS
+#endif
