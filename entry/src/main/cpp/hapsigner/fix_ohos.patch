+#ifndef SIGNATURETOOLS_TRACE_LOG_H
+#define SIGNATURETOOLS_TRACE_LOG_H
+
+#include <cstdio>
+
+// 签名器诊断输出使用独立文件句柄，避免与 hdc 内核争抢全局 stdout（freopen 竞态）
+extern FILE* g_signTrace;
+
+#define SIGNTRACE(...)                                            \
+    do {                                                          \
+        if (g_signTrace != nullptr) {                             \
+            fprintf(g_signTrace, __VA_ARGS__);                    \
+            fflush(g_signTrace);                                  \
+        }                                                         \
+    } while (0)
+
+#endif
