/build-profile.json5
entry/src/main/resources/rawfile/store/*.p12
entry/src/main/resources/rawfile/store/*.pem
entry/src/main/resources/rawfile/store/*.cer
entry/src/main/resources/rawfile/store/*.p7b
entry/src/main/resources/rawfile/store/*.csr

